# Git LFS: binary assets are stored in LFS and are LOCKABLE.
# Run `git lfs lock <file>` before editing; `git lfs unlock <file>` after pushing.
# Lockable files are checked out read-only until you lock them.

# Unreal
*.uasset   filter=lfs diff=lfs merge=lfs -text lockable
*.umap     filter=lfs diff=lfs merge=lfs -text lockable

# Blender / 3D
*.blend    filter=lfs diff=lfs merge=lfs -text lockable
*.fbx      filter=lfs diff=lfs merge=lfs -text lockable
*.obj      filter=lfs diff=lfs merge=lfs -text lockable
*.glb      filter=lfs diff=lfs merge=lfs -text lockable
*.gltf     filter=lfs diff=lfs merge=lfs -text lockable
*.abc      filter=lfs diff=lfs merge=lfs -text lockable
*.usd      filter=lfs diff=lfs merge=lfs -text lockable
*.usdc     filter=lfs diff=lfs merge=lfs -text lockable

# Textures / images
*.png      filter=lfs diff=lfs merge=lfs -text lockable
*.tga      filter=lfs diff=lfs merge=lfs -text lockable
*.exr      filter=lfs diff=lfs merge=lfs -text lockable
*.hdr      filter=lfs diff=lfs merge=lfs -text lockable
*.psd      filter=lfs diff=lfs merge=lfs -text lockable
*.tif      filter=lfs diff=lfs merge=lfs -text lockable
*.tiff     filter=lfs diff=lfs merge=lfs -text lockable
*.jpg      filter=lfs diff=lfs merge=lfs -text lockable
*.jpeg     filter=lfs diff=lfs merge=lfs -text lockable
*.kra      filter=lfs diff=lfs merge=lfs -text lockable
*.spp      filter=lfs diff=lfs merge=lfs -text lockable

# Audio / video
*.wav      filter=lfs diff=lfs merge=lfs -text lockable
*.mp3      filter=lfs diff=lfs merge=lfs -text lockable
*.ogg      filter=lfs diff=lfs merge=lfs -text lockable
*.flac     filter=lfs diff=lfs merge=lfs -text lockable
*.mp4      filter=lfs diff=lfs merge=lfs -text lockable
*.mov      filter=lfs diff=lfs merge=lfs -text lockable

# Text files: normalise line endings across macOS and Windows
*.py       text eol=lf
*.md       text eol=lf
*.ini      text
*.json     text eol=lf
*.uproject text eol=lf
